@model PresentationLayer.ViewModels.EditTripPlacesByCountryViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Country</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Country.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country.Capital)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Country.Capital)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country.Currency)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Country.Currency)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country.Language)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Country.Language)
        </dd>
    </dl>
</div>
<div>
    @* <a asp-action="Edit" asp-route-id="@Model?.AlphaCode">Edit</a> | *@
   @*  <a asp-action="EditTripCountries" asp-route-tripId="@Model.TripId" style="color: #2f4f4f;">Back to List</a> *@
</div>
<a asp-controller="Places" asp-action="EditTripPlaces" asp-route-tripId="@Model.TripId" asp-route-countryName="@Model.Country.Name" class="btn btn-info" style="background-color: #2f4f4f; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
    Edit Places in @Model.Country.Name
</a>
