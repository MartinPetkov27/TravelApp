@model IEnumerable<BusinessLayer.Story>

@{
    ViewData["Title"] = "Index";
}
@* <head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head> *@
<h1>Read More Stories</h1>

<p>
    <a asp-action="Index" style="color: #2f4f4f;">Back to Stories page</a>
</p>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model.Where(s => s.Status == BusinessLayer.Status.Approved))
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>

                    @if (!string.IsNullOrEmpty(item.ImageUrls.FirstOrDefault()))
                    {
                        <img src="@item.ImageUrls.FirstOrDefault()" class="card-img-top mb-3 rounded" alt="Story image" style="max-height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="" class="card-img-top mb-3 rounded" alt="Story image" style="max-height: 180px; object-fit: cover;" />

                    }
                    <p class="card-text text-truncate" style="max-height: 4.5em; overflow: hidden;" title="@item.Content">
                        @item.Content
                    </p>

                    @* <p class="mb-1"><strong>Status:</strong> @item.Status</p>
                    <p class="mb-2"><strong>User:</strong> @item.User.Email</p> *@
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between">
                    <a asp-action="Read" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" style="background-color: #2f4f4f; color: white; text-decoration: none; border-radius: 5px;">Read</a>
                </div>
            </div>
        </div>
    }
</div>
