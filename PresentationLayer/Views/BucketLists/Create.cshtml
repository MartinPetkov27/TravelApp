@model BusinessLayer.BucketList

@{
    ViewData["Title"] = "Add Places";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="mb-4 text-center fw-bold text-primary" style="color:#60a1a0!important; ">Create New Entry</h2>
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Place1" class="form-label">Place1</label>
                            <input asp-for="Place1" class="form-control" placeholder="Place1" />
                            <span asp-validation-for="Place1" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageUrl1" class="form-label">ImageUrl1</label>
                            <input asp-for="ImageUrl1" class="form-control" placeholder="ImageUrl1" />
                            <span asp-validation-for="ImageUrl1" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Place2" class="form-label">Place2</label>
                            <input asp-for="Place2" class="form-control" placeholder="Place2"  />
                            <span asp-validation-for="Place2" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageUrl2" class="form-label">ImageUrl2</label>
                            <input asp-for="ImageUrl2" class="form-control" placeholder="ImageUrl2" />
                            <span asp-validation-for="ImageUrl2" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Place3" class="form-label">Place3</label>
                            <input asp-for="Place3" class="form-control" placeholder="Place3" />
                            <span asp-validation-for="Place3" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageUrl3" class="form-label">ImageUrl3</label>
                                <input asp-for="ImageUrl3" class="form-control" placeholder="ImageUrl3"  />
                            <span asp-validation-for="ImageUrl3" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Place4" class="form-label">Place4</label>
                            <input asp-for="Place4" class="form-control" placeholder="Place4" />
                            <span asp-validation-for="Place4" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageUrl4" class="form-label">ImageUrl4</label>
                            <input asp-for="ImageUrl4" class="form-control" placeholder="ImageUrl4" />
                            <span asp-validation-for="ImageUrl4" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Place5" class="form-label">Place5</label>
                            <input asp-for="Place5" class="form-control" placeholder="Place5" />
                            <span asp-validation-for="Place5" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageUrl5" class="form-label">ImageUrl5</label>
                            <input asp-for="ImageUrl5" class="form-control" placeholder="ImageUrl5" />
                            <span asp-validation-for="ImageUrl5" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-3 fw-semibold" style="background-color: #2f4f4f; color: white">
                            Submit
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}