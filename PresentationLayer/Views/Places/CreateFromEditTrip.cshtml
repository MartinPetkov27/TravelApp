@model BusinessLayer.Place;

@{
    ViewData["Title"] = "Create";
    var countries = ViewBag.Countries as List<string>;
    var tripName = ViewBag.TripName;
    var selectedCountryName = ViewBag.SelectedCountryName;
    var selectedCountryAlphaCode = ViewBag.SelectedCountryAlphaCode;
    string lastEndingDate = ViewBag.LastEndingDate;
 }

<head>
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</head>
<div class="map-container">
    @* <input type="hidden" id="selectedCountryName" value="@selectedCountryName" /> *@
    <div class="overlay-form">

        <h1 class="text-center">Create a Place</h1>

        <form asp-action="CreateFromTrip" method="post" id="placeForm">
            @Html.AntiForgeryToken()
            <!-- Searchbox -->
            <div class="text-center mb-2">
                <label asp-for="Name">Place name:</label>
                <input asp-for="Name" id="pac-input" class="form-control w-50 mx-auto" type="text" placeholder="Search for a place" style="width:100%!important" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <input asp-for="CoutryAlphaCode" type="hidden" id="countryAlphaCode" value="@selectedCountryAlphaCode" />
            </div>
            <hr />

            <!-- Trip selection -->
            <div class="form-group mb-3">
                <label for="TripName"><strong>Trip Name</strong></label>
                <input type="text" class="form-control" id="TripName" name="TripName" value="@tripName" readonly />
            </div>

            <!-- Coordinates -->
            <div class="form-group d-flex justify-content-center gap-2">
                <div style="flex: 0.5;">
                    <label asp-for="Latitude"></label>
                    <input asp-for="Latitude" class="form-control" id="Latitude" style="width:40%#TripName" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div style="flex: 0.5;">
                    <label asp-for="Longitude"></label>
                    <input asp-for="Longitude" class="form-control" id="Longitude" style="width:40%#TripName" />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
            </div>

            <!-- Description -->
            <div class="form-group text-center">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control w-50 mx-auto" style="width:100%!important" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <!-- Lastly picked date -->
            <div class="form-group text-center">
                <label>Lastly picked date</label>
                <input  class="form-control w-50 mx-auto" style="width:100%!important" placeholder=" @lastEndingDate" disabled/>
            </div>
            <!-- Date Range Picker -->
            <div class="form-group text-center mt-3">
                <label for="DateRange"><strong>Select Dates</strong></label>
                <input type="text" id="DateRange" name="DateRange" class="form-control w-50 mx-auto" placeholder="Select date range" style="width: 100%!important" />
                <input asp-for="StartingDate" type="hidden" id="StartDate" name="StartingDate" />
                <input asp-for="EndingDate" type="hidden" id="EndDate" name="EndingDate" />
            </div>
            <!-- Submit button -->
            <div class="form-group text-center mt-3">
                <button asp-action="CreateFromEditTrip" type="submit" class="btn btn-primary w-50">
                    Create Place
                </button>
            </div>
            <div class="text-center mt-2">
                <a asp-controller="Trips" asp-action="CreateTripSelectCities">Back to trip creation</a>
            </div>
        </form>

        <!-- PopUp for the mismatching coordinates and couuntry name-->
        @if (TempData["CountryMismatch"] != null)
        {
            <div class="modal fade" id="countryMismatchModal" tabindex="-1" role="dialog" aria-labelledby="countryMismatchLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h5 class="modal-title" id="countryMismatchLabel">Country Mismatch</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body text-danger">
                            @TempData["CountryMismatch"]
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
                        </div>
                    </div>
                </div>
            </div>

            <text>
                <script>
                    window.onload = function () {
                        var modal = new bootstrap.Modal(document.getElementById('countryMismatchModal'));
                        modal.show();
                    };
                </script>
            </text>
        }

        <!-- Popup Modal -->
        <div id="countryMismatchModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <p>The selected coordinates do <strong>not</strong> belong to the selected country.</p>
            </div>
            <style>
                .modal {
                    display: none; /* Hidden by default */
                    position: fixed;
                    z-index: 999;
                    left: 0;
                    top: 0;
                    width: 100%;
                    height: 100%;
                    overflow: auto;
                    background-color: rgba(0, 0, 0, 0.4);
                }

                .modal-content {
                    background-color: #fff;
                    margin: 15% auto;
                    padding: 20px;
                    border-radius: 8px;
                    width: 80%;
                    max-width: 400px;
                    text-align: center;
                    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                }

                .close {
                    color: #aaa;
                    float: right;
                    font-size: 24px;
                    font-weight: bold;
                    cursor: pointer;
                }

                    .close:hover,
                    .close:focus {
                        color: #000;
                        text-decoration: none;
                    }
            </style>
        </div>

    </div>

    <!-- Google Map -->
    <div id="placeMap"></div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVCMcaodMWF5rbNUVo7YdZaAIHPC3draE&libraries=places&language=en" async defer></script>

<script>
    //date range picker:
        const lastEndingDate = "@ViewBag.LastEndingDate";
            console.log("JavaScript lastEndingDate:", lastEndingDate);

                   flatpickr("#DateRange", {
            mode: "range",
            dateFormat: "Y-m-d",
            minDate:   "today",
            onClose: function(selectedDates, dateStr, instance) {
                if (selectedDates.length > 0) {
                    document.getElementById('StartDate').value = selectedDates[0].toISOString().slice(0, 10);
                }
                if (selectedDates.length > 1) {
                    document.getElementById('EndDate').value = selectedDates[1].toISOString().slice(0, 10);
                }
            }
        });
            //aler for validating EndDate > StartDate
                    document.getElementById("placeForm").addEventListener("submit", function (e) {
            const startDate = document.getElementById("StartDate").value;
            const endDate = document.getElementById("EndDate").value;

            if (startDate && endDate) {
                const start = new Date(startDate);
                const end = new Date(endDate);

                if (start > end) {
                    e.preventDefault(); 
                    alert("End Date must be after Start Date!");
                }
            }
        });

    let map, marker, autocomplete;

    const selectedCountryName = "@ViewBag.SelectedCountry";

    function initMap() {
        const defaultLocation = { lat: 20, lng: 0 };
        map = new google.maps.Map(document.getElementById("placeMap"), {
            zoom: 2,
            center: defaultLocation
        });

        marker = new google.maps.Marker({
            position: defaultLocation,
            map: map,
            draggable: true
        });

        // Autocomplete Search
        const input = document.getElementById("pac-input");
        autocomplete = new google.maps.places.Autocomplete(input);
        autocomplete.bindTo("bounds", map);

        autocomplete.addListener("place_changed", () => {
            const place = autocomplete.getPlace();
            if (!place.geometry) {
                alert("No details available for input: '" + place.name + "'");
                return;
            }

            if (place.geometry.viewport) {
                map.fitBounds(place.geometry.viewport);
            } else {
                map.setCenter(place.geometry.location);
                map.setZoom(10);
            }

            marker.setPosition(place.geometry.location);
            document.getElementById("Latitude").value = place.geometry.location.lat().toFixed(6);
            document.getElementById("Longitude").value = place.geometry.location.lng().toFixed(6);
        });

        map.addListener("click", function (e) {
            marker.setPosition(e.latLng);
            map.panTo(e.latLng);
            document.getElementById("Latitude").value = e.latLng.lat().toFixed(6);
            document.getElementById("Longitude").value = e.latLng.lng().toFixed(6);
        });
        
        document.getElementById("pac-input").addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault(); // Prevent form submit
            }
        });

        document.getElementById("Latitude").addEventListener("change", updateFromInputs);
        document.getElementById("Longitude").addEventListener("change", updateFromInputs);

        function updateFromInputs() {
            const lat = parseFloat(document.getElementById("Latitude").value);
            const lng = parseFloat(document.getElementById("Longitude").value);
            if (!isNaN(lat) && !isNaN(lng)) {
                const latLng = new google.maps.LatLng(lat, lng);
                marker.setPosition(latLng);
                map.panTo(latLng);
                map.setZoom(6);
            }
        }

        // 🌎 Zoom immediately on page load if country is available
        if (selectedCountryName && selectedCountryName.trim() !== "") {
            const geocoder = new google.maps.Geocoder();
            geocoder.geocode({ address: selectedCountryName }, function(results, status) {
                if (status === "OK") {
                    map.setCenter(results[0].geometry.location);
                    map.setZoom(5);
                    marker.setPosition(results[0].geometry.location);
                } else {
                    console.error("Could not find country:", status);
                }
            });
        }
    }

    window.onload = initMap;

    // Country dropdown functionality
    document.querySelectorAll(".country-option").forEach(function (item) {
        item.addEventListener("click", function () {
            const countryName = this.textContent;
            document.getElementById("countryDropdown").textContent = countryName;
            document.getElementById("selectedCountryInput").value = countryName;
            document.getElementById("countryList").style.display = "none";

            const geocoder = new google.maps.Geocoder();
            geocoder.geocode({ address: countryName }, function(results, status) {
                if (status === "OK") {
                    map.setCenter(results[0].geometry.location);
                    map.setZoom(5);
                    marker.setPosition(results[0].geometry.location);
                } else {
                    alert("Could not find country: " + status);
                }
            });
        });
    });

    // Close dropdown on outside click
    document.addEventListener("click", function (event) {
        const dropdown = document.getElementById("countryDropdown");
        const list = document.getElementById("countryList");
        //just changed:
            if (dropdown && list && !dropdown.contains(event.target) && !list.contains(event.target)) {
            list.style.display = "none";
        }
    });

    //Coordinates validation:
          document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("placeForm");
            const expectedCountryName = "@ViewBag.SelectedCountry".trim().toLowerCase();
            // const expectedCountryName = document.getElementById("selectedCountryName").value.trim().toLowerCase();
            const modal = document.getElementById("countryMismatchModal");
            const closeBtn = document.querySelector(".modal .close");

            closeBtn.onclick = function () {
                modal.style.display = "none";
            };

            window.onclick = function (event) {
                if (event.target === modal) {
                    modal.style.display = "none";
                }
            };

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const lat = parseFloat(document.getElementById("Latitude").value);
                const lng = parseFloat(document.getElementById("Longitude").value);

                if (isNaN(lat) || isNaN(lng)) {
                    alert("Please enter valid coordinates.");
                    return;
                }

                const geocoder = new google.maps.Geocoder();
                const latlng = { lat, lng };

                geocoder.geocode({ location: latlng }, function (results, status) {
                    if (status === "OK" && results[0]) {
                        let countryName = null;

                        for (const component of results[0].address_components) {
                            if (component.types.includes("country")) {
                                countryName = component.long_name.toLowerCase(); // full name like "Germany"
                                break;
                            }
                        }

                        console.log("Expected Country:", expectedCountryName);
                        console.log("Detected Country:", countryName);

                        if (
                            countryName &&
                            expectedCountryName &&
                            countryName.trim().toLowerCase() !== expectedCountryName.trim().toLowerCase()
                        ) {
                            console.log("Mismatch detected, showing modal.");
                            modal.style.display = "block";
                        } else {
                            console.log("Match detected, submitting form.");
                            form.submit();
                        }

                    } else {
                        alert("Failed to validate location. Please try again.");
                    }
                });
            });
        });
</script>
}